{
  "id": "jitter",
  "name": "Jitter",
  "description": "Handheld micro-shake UV offset. Documentary / anxiety / live cam feel.",
  "roles": ["postprocess"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_amount",
      "label": "Amount",
      "type": "float",
      "default": 0.35,
      "min": 0.0,
      "max": 1.5,
      "step": 0.01,
      "group": "Distort",
      "widget": "slider"
    },
    {
      "name": "u_speed",
      "label": "Speed",
      "type": "float",
      "default": 2.5,
      "min": 0.0,
      "max": 8.0,
      "step": 0.05,
      "group": "Distort",
      "widget": "slider"
    },
    {
      "name": "u_roughness",
      "label": "Roughness",
      "type": "float",
      "default": 0.45,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Distort",
      "widget": "slider",
      "hint": "High-frequency shake layer"
    },
    {
      "name": "u_intensity",
      "label": "Mix",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Mix",
      "widget": "slider",
      "format": "percent",
      "hint": "0 = original scene, 1 = full jitter"
    }
  ]
}
