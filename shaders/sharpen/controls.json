{
  "id": "sharpen",
  "name": "Sharpen",
  "description": "Unsharp-mask style sharpen after soft or display FX. Easy to overdo — start low.",
  "roles": ["postprocess"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_amount",
      "label": "Amount",
      "type": "float",
      "default": 0.45,
      "min": 0.0,
      "max": 2.0,
      "step": 0.01,
      "group": "Optics",
      "widget": "slider",
      "hint": "Sharpen strength"
    },
    {
      "name": "u_radius",
      "label": "Radius",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 4.0,
      "step": 0.1,
      "group": "Optics",
      "widget": "slider",
      "hint": "Sample offset in pixels"
    },
    {
      "name": "u_intensity",
      "label": "Mix",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Mix",
      "widget": "slider",
      "format": "percent",
      "hint": "0 = original scene, 1 = full sharpen"
    }
  ]
}
