{
  "id": "bg-wind-lic",
  "name": "Wind LIC",
  "description": "Line Integral Convolution wind visualization from Three-World. Container fill — animated streamline pattern.",
  "roles": ["container"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_fieldSize",
      "label": "Field Size",
      "type": "float",
      "default": 10.0,
      "min": 1.0,
      "max": 30.0,
      "step": 0.5,
      "group": "Field",
      "widget": "slider",
      "order": 1
    },
    {
      "name": "u_windDir",
      "label": "Direction",
      "type": "vec2",
      "default": [1.0, 0.0],
      "group": "Wind",
      "widget": "vec",
      "order": 10
    },
    {
      "name": "u_windSpeed",
      "label": "Speed",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 4.0,
      "step": 0.05,
      "group": "Wind",
      "widget": "slider",
      "order": 11
    },
    {
      "name": "u_windStrength",
      "label": "Strength",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 3.0,
      "step": 0.05,
      "group": "Wind",
      "widget": "slider",
      "order": 12
    },
    {
      "name": "u_windWaveFreq",
      "label": "Wave Freq",
      "type": "float",
      "default": 0.3,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "group": "Wind",
      "widget": "slider",
      "order": 13
    },
    {
      "name": "u_gustStrength",
      "label": "Gust Strength",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "group": "Gusts",
      "widget": "slider",
      "order": 20
    },
    {
      "name": "u_gustSpeed",
      "label": "Gust Speed",
      "type": "float",
      "default": 0.8,
      "min": 0.0,
      "max": 3.0,
      "step": 0.05,
      "group": "Gusts",
      "widget": "slider",
      "order": 21
    },
    {
      "name": "u_gustFrequency",
      "label": "Gust Freq",
      "type": "float",
      "default": 2.0,
      "min": 0.0,
      "max": 6.0,
      "step": 0.1,
      "group": "Gusts",
      "widget": "slider",
      "order": 22
    },
    {
      "name": "u_turbulence",
      "label": "Turbulence",
      "type": "float",
      "default": 0.3,
      "min": 0.0,
      "max": 1.5,
      "step": 0.05,
      "group": "Wind",
      "widget": "slider",
      "order": 14
    },
    {
      "name": "u_lineColor",
      "label": "Color",
      "type": "color",
      "default": [1.0, 1.0, 1.0],
      "group": "Lines",
      "widget": "color",
      "order": 30
    },
    {
      "name": "u_lineOpacity",
      "label": "Opacity",
      "type": "float",
      "default": 0.6,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Lines",
      "widget": "slider",
      "format": "percent",
      "order": 31
    },
    {
      "name": "u_lineLength",
      "label": "Length",
      "type": "float",
      "default": 1.0,
      "min": 0.1,
      "max": 3.0,
      "step": 0.05,
      "group": "Lines",
      "widget": "slider",
      "order": 32
    },
    {
      "name": "u_lineSteps",
      "label": "Steps",
      "type": "float",
      "default": 32.0,
      "min": 8.0,
      "max": 64.0,
      "step": 1.0,
      "group": "Lines",
      "widget": "stepper",
      "order": 33,
      "hint": "Trace resolution (higher = smoother, costlier)"
    },
    {
      "name": "u_lineScale",
      "label": "Scale",
      "type": "float",
      "default": 1.0,
      "min": 0.1,
      "max": 3.0,
      "step": 0.05,
      "group": "Lines",
      "widget": "slider",
      "order": 34
    },
    {
      "name": "u_lineFade",
      "label": "Fade",
      "type": "float",
      "default": 1.5,
      "min": 0.5,
      "max": 4.0,
      "step": 0.1,
      "group": "Lines",
      "widget": "slider",
      "order": 35
    },
    {
      "name": "u_gustOpacity",
      "label": "Gust Opacity",
      "type": "float",
      "default": 0.4,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Lines",
      "widget": "slider",
      "format": "percent",
      "order": 36
    }
  ]
}
