{
  "id": "audio-history",
  "name": "Audio History",
  "description": "Scrolling history strip of a routed analysis channel. Style, height range, and palette are tunable.",
  "roles": ["container"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_color_low",
      "label": "Low",
      "type": "color",
      "default": [0.12, 0.32, 0.8],
      "group": "Style",
      "widget": "color",
      "order": 1,
      "hint": "Color at low energy"
    },
    {
      "name": "u_color_mid",
      "label": "Mid",
      "type": "color",
      "default": [0.55, 0.35, 0.95],
      "group": "Style",
      "widget": "color",
      "order": 2
    },
    {
      "name": "u_color_high",
      "label": "High",
      "type": "color",
      "default": [0.98, 0.5, 0.75],
      "group": "Style",
      "widget": "color",
      "order": 3,
      "hint": "Color at peak energy"
    },
    {
      "name": "u_bg_color",
      "label": "Background",
      "type": "color",
      "default": [0.025, 0.018, 0.05],
      "group": "Style",
      "widget": "color",
      "order": 4
    },
    {
      "name": "u_intensity",
      "label": "Intensity",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Style",
      "widget": "slider",
      "format": "percent",
      "order": 5
    },
    {
      "name": "u_contrast",
      "label": "Contrast",
      "type": "float",
      "default": 1.2,
      "min": 0.4,
      "max": 2.5,
      "step": 0.05,
      "group": "Style",
      "widget": "slider",
      "order": 6
    },
    {
      "name": "u_height",
      "label": "Height range",
      "type": "float",
      "default": 0.48,
      "min": 0.1,
      "max": 0.95,
      "step": 0.01,
      "group": "Shape",
      "widget": "slider",
      "format": "percent",
      "order": 10,
      "hint": "Max vertical span of the history envelope"
    },
    {
      "name": "u_weight",
      "label": "Edge weight",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Shape",
      "widget": "slider",
      "format": "percent",
      "order": 11,
      "hint": "Sharpness of the envelope outline"
    },
    {
      "name": "u_glow",
      "label": "Glow",
      "type": "float",
      "default": 0.55,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Shape",
      "widget": "slider",
      "format": "percent",
      "order": 12
    },
    {
      "name": "u_fill",
      "label": "Fill",
      "type": "float",
      "default": 0.7,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Shape",
      "widget": "slider",
      "format": "percent",
      "order": 13
    },
    {
      "name": "u_age_fade",
      "label": "Age fade",
      "type": "float",
      "default": 0.45,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Shape",
      "widget": "slider",
      "format": "percent",
      "order": 14,
      "hint": "Dim older samples toward the left"
    },
    {
      "name": "u_playhead",
      "label": "Playhead",
      "type": "float",
      "default": 0.55,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Chrome",
      "widget": "slider",
      "format": "percent",
      "order": 20
    },
    {
      "name": "u_ticks",
      "label": "Ticks",
      "type": "float",
      "default": 0.35,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Chrome",
      "widget": "slider",
      "format": "percent",
      "order": 21
    },
    {
      "name": "u_window",
      "label": "Synth window",
      "type": "float",
      "default": 8.0,
      "min": 2.0,
      "max": 30.0,
      "step": 0.5,
      "group": "History",
      "widget": "slider",
      "unit": "s",
      "advanced": true,
      "hint": "Synthetic mode only (when live history is off)"
    },
    {
      "name": "u_scroll",
      "label": "Synth scroll",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 3.0,
      "step": 0.05,
      "group": "History",
      "widget": "slider",
      "advanced": true
    },
    {
      "name": "u_energy",
      "label": "Energy",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Audio",
      "widget": "slider",
      "format": "percent",
      "advanced": true,
      "hint": "Overridden by analysis routing"
    },
    {
      "name": "u_use_history",
      "label": "Use live history",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 1.0,
      "group": "Audio",
      "widget": "toggle",
      "advanced": true
    },
    {
      "name": "u_write_head",
      "label": "Write head",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.001,
      "group": "Audio",
      "widget": "slider",
      "advanced": true
    },
    {
      "name": "u_history_filled",
      "label": "Filled",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.001,
      "group": "Audio",
      "widget": "slider",
      "advanced": true
    }
  ]
}
