{
  "id": "column-shift",
  "name": "Column Shift",
  "description": "Per-column vertical offsets. Vertical twin of Row Shift.",
  "roles": ["postprocess"],
  "entry": "shader.frag",
  "uniforms": [
    { "name": "u_amount", "label": "Amount", "type": "float", "default": 0.35, "min": 0.0, "max": 1.5, "step": 0.01, "group": "Glitch", "widget": "slider" },
    { "name": "u_frequency", "label": "Columns", "type": "float", "default": 60.0, "min": 8.0, "max": 200.0, "step": 1.0, "group": "Glitch", "widget": "stepper" },
    { "name": "u_speed", "label": "Speed", "type": "float", "default": 2.5, "min": 0.0, "max": 20.0, "step": 0.5, "group": "Glitch", "widget": "slider" },
    { "name": "u_intensity", "label": "Mix", "type": "float", "default": 1.0, "min": 0.0, "max": 1.0, "step": 0.01, "group": "Mix", "widget": "slider", "format": "percent", "hint": "0 = original, 1 = full shift" }
  ]
}
