{
  "id": "halftone",
  "name": "Halftone",
  "description": "Dot-screen print look from luminance. Pair with contrast-sat or dither for posters.",
  "roles": ["postprocess"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_scale",
      "label": "Scale",
      "type": "float",
      "default": 6.0,
      "min": 1.5,
      "max": 24.0,
      "step": 0.1,
      "group": "Style",
      "widget": "slider",
      "hint": "Dot density (higher = finer)"
    },
    {
      "name": "u_angle",
      "label": "Angle",
      "type": "float",
      "default": 22.0,
      "min": 0.0,
      "max": 90.0,
      "step": 1.0,
      "group": "Style",
      "widget": "slider",
      "hint": "Screen rotation in degrees"
    },
    {
      "name": "u_contrast",
      "label": "Contrast",
      "type": "float",
      "default": 1.2,
      "min": 0.3,
      "max": 3.0,
      "step": 0.01,
      "group": "Style",
      "widget": "slider",
      "hint": "Luma contrast before screening"
    },
    {
      "name": "u_color_ink",
      "label": "Ink",
      "type": "color",
      "default": [0.08, 0.08, 0.1],
      "group": "Style",
      "widget": "color"
    },
    {
      "name": "u_color_paper",
      "label": "Paper",
      "type": "color",
      "default": [0.96, 0.94, 0.88],
      "group": "Style",
      "widget": "color"
    },
    {
      "name": "u_intensity",
      "label": "Mix",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Mix",
      "widget": "slider",
      "format": "percent",
      "hint": "0 = original scene, 1 = full halftone"
    }
  ]
}
