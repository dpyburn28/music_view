{
  "id": "thermal",
  "name": "Thermal / FLIR",
  "description": "Thermal camera look: luminance mapped to a heat palette, soft blobs, low detail, and scintillation noise.",
  "roles": [
    "postprocess"
  ],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_softness",
      "label": "Blob soft",
      "type": "float",
      "default": 0.55,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Image",
      "widget": "slider"
    },
    {
      "name": "u_contrast",
      "label": "Heat contrast",
      "type": "float",
      "default": 1.15,
      "min": 0.5,
      "max": 2.5,
      "step": 0.01,
      "group": "Image",
      "widget": "slider"
    },
    {
      "name": "u_brightness",
      "label": "Level offset",
      "type": "float",
      "default": 0.0,
      "min": -0.3,
      "max": 0.3,
      "step": 0.01,
      "group": "Image",
      "widget": "slider"
    },
    {
      "name": "u_noise",
      "label": "Sensor noise",
      "type": "float",
      "default": 0.1,
      "min": 0.0,
      "max": 0.4,
      "step": 0.01,
      "group": "Image",
      "advanced": true,
      "widget": "slider"
    },
    {
      "name": "u_palette",
      "label": "Palette",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 2.0,
      "step": 1.0,
      "group": "Palette",
      "widget": "segmented",
      "options": [
        {
          "value": 0,
          "label": "Iron"
        },
        {
          "value": 1,
          "label": "Rainbow"
        },
        {
          "value": 2,
          "label": "White hot"
        }
      ],
      "hint": "Heat color LUT (0=iron 1=rainbow 2=whitehot)"
    },
    {
      "name": "u_scan",
      "label": "Scanline HUD",
      "type": "float",
      "default": 0.15,
      "min": 0.0,
      "max": 0.6,
      "step": 0.01,
      "group": "HUD",
      "advanced": true,
      "widget": "slider"
    },
    {
      "name": "u_intensity",
      "label": "Effect mix",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Mix",
      "format": "percent",
      "unit": "%",
      "hint": "Blend of processed vs original",
      "widget": "slider"
    }
  ]
}
