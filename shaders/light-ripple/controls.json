      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Style",
      "widget": "slider",
      "format": "percent",
      "order": 21
    },
    {
      "name": "u_bg_color",
      "label": "Background",
      "type": "color",
      "default": [0.0, 0.0, 0.0],
      "group": "Style",
      "widget": "color",
      "order": 22
    },
    {
      "name": "u_fg_color",
      "label": "Foreground",
      "type": "color",
      "default": [1.0, 1.0, 1.0],
      "group": "Style",
