{
  "id": "light-ripple",
  "name": "Light Ripple",
  "description": "Animated ripple pattern by Danilo Guanabara. Credit: pouet.net/prod.php?which=57245",
  "roles": ["container"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_speed",
