      "max": 1.0,
      "step": 0.01,
      "group": "Shape",
      "widget": "slider",
      "format": "percent",
      "order": 10,
      "hint": "Step function cutoff"
    },
    {
      "name": "u_zoom",
      "label": "Zoom",
      "type": "float",
      "default": 1.0,
