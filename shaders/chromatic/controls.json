{
  "id": "chromatic",
  "name": "Chromatic Aberration",
  "description": "Radial RGB channel split for a lens / produced look. Pair with bloom and vignette.",
  "roles": ["postprocess"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_amount",
      "label": "Amount",
      "type": "float",
      "default": 0.006,
      "min": 0.0,
      "max": 0.05,
      "step": 0.0005,
      "group": "Optics",
      "widget": "slider",
      "hint": "Radial channel separation (keep subtle)"
    },
    {
      "name": "u_intensity",
      "label": "Mix",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Mix",
      "widget": "slider",
      "format": "percent",
      "hint": "0 = original scene, 1 = full effect"
    }
  ]
}
