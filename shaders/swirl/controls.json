{
  "id": "swirl",
  "name": "Swirl",
  "description": "Vortex UV warp around a center. Good for tunnels and psychedelic mids.",
  "roles": ["postprocess"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_amount",
      "label": "Twist",
      "type": "float",
      "default": 2.5,
      "min": -8.0,
      "max": 8.0,
      "step": 0.05,
      "group": "Distort",
      "widget": "slider",
      "hint": "Twist strength (radians scale)"
    },
    {
      "name": "u_radius",
      "label": "Radius",
      "type": "float",
      "default": 0.55,
      "min": 0.1,
      "max": 1.5,
      "step": 0.01,
      "group": "Distort",
      "widget": "slider"
    },
    {
      "name": "u_spin",
      "label": "Spin",
      "type": "float",
      "default": 0.15,
      "min": -2.0,
      "max": 2.0,
      "step": 0.01,
      "group": "Distort",
      "widget": "slider"
    },
    {
      "name": "u_center_x",
      "label": "Center X",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Distort",
      "widget": "slider",
      "advanced": true,
      "pairWith": "u_center_y"
    },
    {
      "name": "u_center_y",
      "label": "Center Y",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Distort",
      "widget": "slider",
      "advanced": true
    },
    {
      "name": "u_intensity",
      "label": "Mix",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Mix",
      "widget": "slider",
      "format": "percent",
      "hint": "0 = original scene, 1 = full swirl"
    }
  ]
}
