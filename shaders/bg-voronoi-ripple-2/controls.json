{
  "id": "bg-voronoi-ripple-2",
  "name": "Voronoi Ripple 2",
  "description": "Container-aware: glowing outlines + ripple arcs connecting floating containers. Falls back to Voronoi mesh when disabled. Stage / panel fill.",
  "roles": ["container"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_containerAware",
      "label": "Container Aware",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 1.0,
      "group": "Mode",
      "widget": "toggle",
      "hint": "Glowing container edges + connecting arcs (off = free-form Voronoi)"
    },
    {
      "name": "u_borderSharpness",
      "label": "Border Glow",
      "type": "float",
      "default": 8.0,
      "min": 2.0,
      "max": 20.0,
      "step": 0.5,
      "group": "Container",
      "widget": "slider",
      "order": 1,
      "hint": "Container outline glow sharpness"
    },
    {
      "name": "u_arcSharpness",
      "label": "Arc Glow",
      "type": "float",
      "default": 10.0,
      "min": 3.0,
      "max": 30.0,
      "step": 0.5,
      "group": "Container",
      "widget": "slider",
      "order": 2,
      "hint": "Connection arc line glow"
    },
    {
      "name": "u_arcCount",
      "label": "Arcs Per Container",
      "type": "float",
      "default": 2.0,
      "min": 1.0,
      "max": 4.0,
      "step": 1.0,
      "group": "Container",
      "widget": "stepper",
      "order": 3,
      "hint": "Number of arcs extending from each container"
    },
    {
      "name": "u_arcWobble",
      "label": "Wobble",
      "type": "float",
      "default": 0.015,
      "min": 0.0,
      "max": 0.05,
      "step": 0.001,
      "group": "Container",
      "widget": "slider",
      "order": 4,
      "hint": "Ripple displacement amplitude on arcs"
    },
    {
      "name": "u_arcFrequency",
      "label": "Ripple Freq",
      "type": "float",
      "default": 10.0,
      "min": 2.0,
      "max": 20.0,
      "step": 0.5,
      "group": "Container",
      "widget": "slider",
      "order": 5,
      "hint": "Wave count along each arc"
    },
    {
      "name": "u_nodeIntensity",
      "label": "Nodes",
      "type": "float",
      "default": 1.2,
      "min": 0.0,
      "max": 3.0,
      "step": 0.05,
      "group": "Container",
      "widget": "slider",
      "order": 6,
      "hint": "Junction bloom where arcs meet borders"
    },
    {
      "name": "u_scale",
      "label": "Scale",
      "type": "float",
      "default": 8.0,
      "min": 2.0,
      "max": 20.0,
      "step": 0.1,
      "group": "Fallback Voronoi",
      "widget": "slider",
      "order": 10,
      "hint": "Cell density (Voronoi fallback only)",
      "advanced": true
    },
    {
      "name": "u_edge",
      "label": "Edge",
      "type": "float",
      "default": 12.0,
      "min": 2.0,
      "max": 30.0,
      "step": 0.5,
      "group": "Fallback Voronoi",
      "widget": "slider",
      "order": 11,
      "hint": "Edge glow sharpness (Voronoi fallback only)",
      "advanced": true
    },
    {
      "name": "u_warp",
      "label": "Warp",
      "type": "float",
      "default": 0.4,
      "min": 0.0,
      "max": 1.5,
      "step": 0.01,
      "group": "Fallback Voronoi",
      "widget": "slider",
      "order": 12,
      "hint": "Domain warp amplitude (Voronoi fallback only)",
      "advanced": true
    },
    {
      "name": "u_warpSpeed",
      "label": "Warp Speed",
      "type": "float",
      "default": 0.3,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Fallback Voronoi",
      "widget": "slider",
      "order": 13,
      "hint": "Warp animation rate (Voronoi fallback only)",
      "advanced": true
    },
    {
      "name": "u_speed",
      "label": "Speed",
      "type": "float",
      "default": 0.3,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "group": "Motion",
      "widget": "slider",
      "order": 20,
      "hint": "0 freezes the still"
    }
  ]
}
