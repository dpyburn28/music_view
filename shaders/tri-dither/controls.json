{
  "id": "tri-dither",
  "name": "Triangle Dither",
  "description": "Triangular PDF noise dither — softer banding than uniform random. Great for high-bit→low-bit utility.",
  "roles": ["postprocess"],
  "entry": "shader.frag",
  "uniforms": [
    { "name": "u_levels", "label": "Levels", "type": "float", "default": 12.0, "min": 2.0, "max": 48.0, "step": 1.0, "group": "Dither", "widget": "stepper" },
    { "name": "u_spread", "label": "Spread", "type": "float", "default": 1.0, "min": 0.0, "max": 3.0, "step": 0.05, "group": "Dither", "widget": "slider" },
    { "name": "u_animate", "label": "Animate", "type": "float", "default": 0.0, "min": 0.0, "max": 2.0, "step": 0.05, "group": "Dither", "widget": "slider" },
    { "name": "u_mono", "label": "Mono", "type": "float", "default": 0.0, "min": 0.0, "max": 1.0, "step": 0.01, "group": "Dither", "widget": "slider", "advanced": true },
    { "name": "u_intensity", "label": "Mix", "type": "float", "default": 1.0, "min": 0.0, "max": 1.0, "step": 0.01, "group": "Mix", "widget": "slider", "format": "percent", "hint": "0 = original, 1 = full dither" }
  ]
}
