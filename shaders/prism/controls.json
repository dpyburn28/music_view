{
  "id": "prism",
  "name": "Prism",
  "description": "Radial spectral dispersion from a center. Stronger at edges — lens / crystal look.",
  "roles": ["postprocess"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_amount",
      "label": "Amount",
      "type": "float",
      "default": 0.55,
      "min": 0.0,
      "max": 2.0,
      "step": 0.01,
      "group": "Optics",
      "widget": "slider"
    },
    {
      "name": "u_angle",
      "label": "Angle",
      "type": "float",
      "default": 0.0,
      "min": -3.1416,
      "max": 3.1416,
      "step": 0.01,
      "group": "Optics",
      "widget": "slider",
      "advanced": true
    },
    {
      "name": "u_center_x",
      "label": "Center X",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Optics",
      "widget": "slider",
      "advanced": true,
      "pairWith": "u_center_y"
    },
    {
      "name": "u_center_y",
      "label": "Center Y",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Optics",
      "widget": "slider",
      "advanced": true
    },
    {
      "name": "u_intensity",
      "label": "Mix",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Mix",
      "widget": "slider",
      "format": "percent",
      "hint": "0 = original scene, 1 = full prism"
    }
  ]
}
