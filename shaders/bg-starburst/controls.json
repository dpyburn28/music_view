{
  "id": "bg-starburst",
  "name": "Polar Burst",
  "description": "Pinched radial starburst with segmented rings and periodic inversion. Stage / panel fill.",
  "roles": ["container"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_rays",
      "label": "Rays",
      "type": "float",
      "default": 22.0,
      "min": 4.0,
      "max": 64.0,
      "step": 1.0,
      "group": "Look",
      "widget": "slider",
      "order": 1
    },
    {
      "name": "u_pinch",
      "label": "Pinch",
      "type": "float",
      "default": 0.55,
      "min": 0.15,
      "max": 1.4,
      "step": 0.01,
      "group": "Look",
      "widget": "slider",
      "order": 2,
      "hint": "pow(r, pinch) — lower pulls the origin into a gravitational glow"
    },
    {
      "name": "u_rings",
      "label": "Rings",
      "type": "float",
      "default": 18.0,
      "min": 2.0,
      "max": 48.0,
      "step": 0.5,
      "group": "Look",
      "widget": "slider",
      "order": 3,
      "hint": "Concentric band density after the radial warp"
    },
    {
      "name": "u_glow",
      "label": "Glow",
      "type": "float",
      "default": 0.72,
      "min": 0.15,
      "max": 1.5,
      "step": 0.01,
      "group": "Look",
      "widget": "slider",
      "order": 4
    },
    {
      "name": "u_crisp",
      "label": "Crisp",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Look",
      "widget": "slider",
      "format": "percent",
      "order": 5,
      "hint": "0 = grayscale burst (the still). 1 = hard 1-bit step"
    },
    {
      "name": "u_pulse",
      "label": "Invert pulse",
      "type": "float",
      "default": 0.35,
      "min": 0.0,
      "max": 4.0,
      "step": 0.05,
      "group": "Motion",
      "widget": "slider",
      "order": 10,
      "hint": "Full-screen invert rate. 0 = no invert"
    },
    {
      "name": "u_spin",
      "label": "Spin",
      "type": "float",
      "default": 0.12,
      "min": 0.0,
      "max": 2.0,
      "step": 0.01,
      "group": "Motion",
      "widget": "slider",
      "order": 11
    },
    {
      "name": "u_speed",
      "label": "Speed",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 4.0,
      "step": 0.05,
      "group": "Motion",
      "widget": "slider",
      "order": 12,
      "hint": "0 freezes the still"
    }
  ]
}
