{
  "id": "value-noise-warp",
  "name": "Value Noise Warp",
  "description": "Multi-octave value-noise UV warp. Heat haze / liquid utility; lighter multi-scale control than warp-noise.",
  "roles": ["postprocess"],
  "entry": "shader.frag",
  "uniforms": [
    { "name": "u_strength", "label": "Strength", "type": "float", "default": 0.35, "min": 0.0, "max": 1.5, "step": 0.01, "group": "Distort", "widget": "slider" },
    { "name": "u_scale", "label": "Scale", "type": "float", "default": 4.0, "min": 0.5, "max": 24.0, "step": 0.5, "group": "Distort", "widget": "slider" },
    { "name": "u_octaves", "label": "Octaves", "type": "float", "default": 3.0, "min": 1.0, "max": 5.0, "step": 1.0, "group": "Distort", "widget": "stepper" },
    { "name": "u_speed", "label": "Speed", "type": "float", "default": 0.4, "min": 0.0, "max": 3.0, "step": 0.05, "group": "Distort", "widget": "slider" },
    { "name": "u_intensity", "label": "Mix", "type": "float", "default": 1.0, "min": 0.0, "max": 1.0, "step": 0.01, "group": "Mix", "widget": "slider", "format": "percent", "hint": "0 = original, 1 = full warp" }
  ]
}
