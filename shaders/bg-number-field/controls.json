{
  "id": "bg-number-field",
  "name": "Number Field",
  "description": "Drifting clusters of printed integers on off-white paper. Stage / panel fill.",
  "roles": ["container"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_density",
      "label": "Density",
      "type": "float",
      "default": 0.48,
      "min": 0.15,
      "max": 1.0,
      "step": 0.01,
      "group": "Look",
      "widget": "slider",
      "format": "percent",
      "order": 1
    },
    {
      "name": "u_scale",
      "label": "Scale",
      "type": "float",
      "default": 18.0,
      "min": 6.0,
      "max": 28.0,
      "step": 0.1,
      "group": "Look",
      "widget": "slider",
      "order": 2
    },
    {
      "name": "u_contrast",
      "label": "Contrast",
      "type": "float",
      "default": 0.7,
      "min": 0.15,
      "max": 1.0,
      "step": 0.01,
      "group": "Look",
      "widget": "slider",
      "format": "percent",
      "order": 3,
      "hint": "How many numbers sit near-black vs pale gray"
    },
    {
      "name": "u_paper",
      "label": "Paper",
      "type": "color",
      "default": [0.97, 0.97, 0.965],
      "group": "Color",
      "widget": "color",
      "order": 4
    },
    {
      "name": "u_ink",
      "label": "Ink",
      "type": "color",
      "default": [0.08, 0.08, 0.09],
      "group": "Color",
      "widget": "color",
      "order": 5
    },
    {
      "name": "u_drift",
      "label": "Drift",
      "type": "float",
      "default": 0.35,
      "min": 0.0,
      "max": 1.5,
      "step": 0.01,
      "group": "Motion",
      "widget": "slider",
      "order": 10
    },
    {
      "name": "u_speed",
      "label": "Speed",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 4.0,
      "step": 0.05,
      "group": "Motion",
      "widget": "slider",
      "order": 11,
      "hint": "0 freezes the still"
    }
  ]
}
