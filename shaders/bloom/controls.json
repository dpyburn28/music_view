{
  "id": "bloom",
  "name": "Bloom",
  "description": "Threshold highlight glow via multi-tap blur. Single-pass full-res; keep radius modest for performance.",
  "roles": ["postprocess"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_threshold",
      "label": "Threshold",
      "type": "float",
      "default": 0.55,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Optics",
      "widget": "slider",
      "hint": "Only pixels brighter than this feed the glow"
    },
    {
      "name": "u_radius",
      "label": "Radius",
      "type": "float",
      "default": 2.5,
      "min": 0.5,
      "max": 12.0,
      "step": 0.1,
      "group": "Optics",
      "widget": "slider",
      "hint": "Blur radius in pixels (higher = softer, costlier)"
    },
    {
      "name": "u_strength",
      "label": "Strength",
      "type": "float",
      "default": 0.65,
      "min": 0.0,
      "max": 2.5,
      "step": 0.01,
      "group": "Optics",
      "widget": "slider",
      "hint": "How much glow is added back"
    },
    {
      "name": "u_iterations",
      "label": "Taps",
      "type": "float",
      "default": 2.0,
      "min": 1.0,
      "max": 4.0,
      "step": 1.0,
      "group": "Optics",
      "widget": "stepper",
      "advanced": true,
      "hint": "Blur quality / sample rings (1–4)"
    },
    {
      "name": "u_intensity",
      "label": "Mix",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Mix",
      "widget": "slider",
      "format": "percent",
      "hint": "0 = original scene, 1 = full effect"
    }
  ]
}
