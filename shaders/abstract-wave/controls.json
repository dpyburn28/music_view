{
  "id": "abstract-wave",
  "name": "Abstract Wave",
  "description": "Psychedelic color loops driven by rotating UV and modular wave distortion.",
  "roles": ["container"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_speed",
      "label": "Speed",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 5.0,
      "step": 0.05,
      "group": "Motion",
      "widget": "slider",
      "order": 1,
      "hint": "Animation speed"
    },
    {
      "name": "u_rot_speed",
      "label": "Rotation speed",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 3.0,
      "step": 0.05,
      "group": "Motion",
      "widget": "slider",
      "order": 2,
      "hint": "How fast the spiral twist rotates"
    },
    {
      "name": "u_detail",
      "label": "Detail",
      "type": "float",
      "default": 4.0,
      "min": 0.5,
      "max": 10.0,
      "step": 0.1,
      "group": "Shape",
      "widget": "slider",
      "order": 10,
      "hint": "Pattern density"
    },
    {
      "name": "u_wave_freq",
      "label": "Wave freq",
      "type": "float",
      "default": 5.0,
      "min": 1.0,
      "max": 15.0,
      "step": 0.25,
      "group": "Shape",
      "widget": "slider",
      "order": 11,
      "hint": "Wave distortion frequency"
    },
    {
      "name": "u_wave_amp",
      "label": "Wave amp",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.5,
      "step": 0.02,
      "group": "Shape",
      "widget": "slider",
      "format": "percent",
      "order": 12,
      "hint": "Wave distortion strength"
    },
    {
      "name": "u_mod_size",
      "label": "Mod size",
      "type": "float",
      "default": 0.5,
      "min": 0.1,
      "max": 1.0,
      "step": 0.02,
      "group": "Shape",
      "widget": "slider",
      "format": "percent",
      "order": 13,
      "hint": "Modular tile size"
    },
    {
      "name": "u_channel_sep",
      "label": "Channel spread",
      "type": "float",
      "default": 0.25,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Color",
      "widget": "slider",
      "format": "percent",
      "order": 20,
      "hint": "How much R/G/B channels differ"
    },
    {
      "name": "u_time_offset",
      "label": "Time offset",
      "type": "float",
      "default": 3.14159,
      "min": 0.0,
      "max": 6.28318,
      "step": 0.05,
      "group": "Color",
      "widget": "slider",
      "order": 21,
      "hint": "Phase offset in the color oscillation"
    },
    {
      "name": "u_mix",
      "label": "Tint mix",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Color",
      "widget": "slider",
      "format": "percent",
      "order": 22,
      "hint": "Blend between color loops and UV-based tint"
    },
    {
      "name": "u_intensity",
      "label": "Intensity",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Style",
      "widget": "slider",
      "format": "percent",
      "order": 30
    }
  ]
}
