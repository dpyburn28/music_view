{
  "id": "blue-noise-dither",
  "name": "Blue Noise Dither",
  "description": "High-frequency dither (IGN + hash). Smoother than Bayer for gradients; great utility grade finisher.",
  "roles": ["postprocess"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_levels",
      "label": "Levels",
      "type": "float",
      "default": 8.0,
      "min": 2.0,
      "max": 32.0,
      "step": 1.0,
      "group": "Dither",
      "widget": "stepper"
    },
    {
      "name": "u_spread",
      "label": "Spread",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 3.0,
      "step": 0.05,
      "group": "Dither",
      "widget": "slider"
    },
    {
      "name": "u_scale",
      "label": "Scale",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 8.0,
      "step": 0.5,
      "group": "Dither",
      "widget": "slider",
      "hint": "Noise grain size in pixels"
    },
    {
      "name": "u_mono",
      "label": "Mono",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Dither",
      "widget": "slider",
      "hint": "1 = dither luminance only"
    },
    {
      "name": "u_animate",
      "label": "Animate",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "group": "Dither",
      "widget": "slider",
      "advanced": true,
      "hint": "Temporal re-roll (film grain dither)"
    },
    {
      "name": "u_intensity",
      "label": "Mix",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Mix",
      "widget": "slider",
      "format": "percent",
      "hint": "0 = original, 1 = full dither"
    }
  ]
}
