{
  "id": "volumetric-fog",
  "name": "Volumetric Fog",
  "description": "Volumetric rendering with scattering, height fog, and dynamic shadows. Based on Sebastien Hillaire's Frostbite SIGGRAPH'15 demo.",
  "roles": ["container"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_speed",
      "label": "Speed",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 3.0,
      "step": 0.05,
      "group": "Motion",
      "widget": "slider",
      "order": 1,
      "hint": "Animation speed"
    },
    {
      "name": "u_quality",
      "label": "Quality",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Motion",
      "widget": "slider",
      "format": "percent",
      "order": 2,
      "hint": "Raymarch quality (lower = faster)"
    },
    {
      "name": "u_fog_noise",
      "label": "Fog noise",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "group": "Fog",
      "widget": "slider",
      "order": 10,
      "hint": "Noise applied to height fog"
    },
    {
      "name": "u_fog_density",
      "label": "Fog density",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 10.0,
      "step": 0.1,
      "group": "Fog",
      "widget": "slider",
      "order": 11,
      "hint": "Height fog multiplier"
    },
    {
      "name": "u_fog_height",
      "label": "Fog height",
      "type": "float",
      "default": 7.0,
      "min": 0.0,
      "max": 20.0,
      "step": 0.5,
      "group": "Fog",
      "widget": "slider",
      "order": 12,
      "hint": "Base height of the fog layer"
    },
    {
      "name": "u_shadow",
      "label": "Shadows",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Lighting",
      "widget": "slider",
      "format": "percent",
      "order": 20,
      "hint": "Volumetric shadow strength"
    },
    {
      "name": "u_light_intensity",
      "label": "Light intensity",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 3.0,
      "step": 0.05,
      "group": "Lighting",
      "widget": "slider",
      "order": 21,
      "hint": "Light brightness multiplier"
    },
    {
      "name": "u_improved",
      "label": "Improved integration",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 1.0,
      "group": "Lighting",
      "widget": "stepper",
      "order": 22,
      "hint": "Frostbite improved scattering integration"
    },
    {
      "name": "u_intensity",
      "label": "Intensity",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Style",
      "widget": "slider",
      "format": "percent",
      "order": 30
    },
    {
      "name": "u_vignette",
      "label": "Vignette",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Style",
      "widget": "slider",
      "format": "percent",
      "order": 31
    }
  ]
}
