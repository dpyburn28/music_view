  "roles": ["container"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_audio_mode",
      "label": "Audio mode",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 3.0,
      "step": 1.0,
      "group": "Audio",
      "widget": "segmented",
      "order": 1,
      "options": [
        { "value": 0, "label": "Energy" },
        { "value": 1, "label": "Beat flash" },
        { "value": 2, "label": "Bass" },
        { "value": 3, "label": "Combined" }
      ],
      "hint": "How audio maps to temperature"
    },
    {
      "name": "u_audio_strength",
      "label": "Strength",
      "type": "float",
      "default": 0.7,
      "min": 0.0,
      "max": 2.0,
      "step": 0.01,
      "group": "Audio",
      "widget": "slider",
      "order": 2,
      "hint": "Audio-to-temperature sensitivity"
    },
    {
