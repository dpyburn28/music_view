{
  "id": "radial-blur",
  "name": "Radial Blur",
  "description": "Zoom / spin blur along rays from a center. Tunnel and speed looks; medium cost.",
  "roles": ["postprocess"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_amount",
      "label": "Amount",
      "type": "float",
      "default": 0.35,
      "min": 0.0,
      "max": 1.5,
      "step": 0.01,
      "group": "Optics",
      "widget": "slider",
      "hint": "Zoom blur strength"
    },
    {
      "name": "u_spin",
      "label": "Spin",
      "type": "float",
      "default": 0.0,
      "min": -1.2,
      "max": 1.2,
      "step": 0.01,
      "group": "Optics",
      "widget": "slider",
      "hint": "Angular blur component"
    },
    {
      "name": "u_samples",
      "label": "Samples",
      "type": "float",
      "default": 6.0,
      "min": 3.0,
      "max": 12.0,
      "step": 1.0,
      "group": "Optics",
      "widget": "stepper",
      "advanced": true,
      "hint": "Quality vs cost"
    },
    {
      "name": "u_center_x",
      "label": "Center X",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Optics",
      "widget": "slider",
      "advanced": true,
      "pairWith": "u_center_y"
    },
    {
      "name": "u_center_y",
      "label": "Center Y",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Optics",
      "widget": "slider",
      "advanced": true
    },
    {
      "name": "u_intensity",
      "label": "Mix",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Mix",
      "widget": "slider",
      "format": "percent",
      "hint": "0 = original scene, 1 = full blur"
    }
  ]
}
