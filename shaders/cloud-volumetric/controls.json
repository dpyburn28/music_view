{
  "id": "cloud-volumetric",
  "name": "Volumetric Clouds",
  "description": "Ray-marched volumetric cloud sphere with procedural noise, Henyey-Greenstein scattering, and audio reactivity.",
  "roles": ["container"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_cloudDensity",
      "label": "Density",
      "type": "float",
      "default": 1.0,
      "min": 0.1,
      "max": 3.0,
      "step": 0.05,
      "group": "Cloud",
      "widget": "slider",
      "order": 1,
      "hint": "Overall cloud thickness"
    },
    {
      "name": "u_cloudScale",
      "label": "Scale",
      "type": "float",
      "default": 3.0,
      "min": 0.5,
      "max": 8.0,
      "step": 0.1,
      "group": "Cloud",
      "widget": "slider",
      "order": 2,
      "hint": "World-space noise frequency"
    },
    {
      "name": "u_octaves",
      "label": "Detail",
      "type": "float",
      "default": 4.0,
      "min": 1.0,
      "max": 8.0,
      "step": 1.0,
      "group": "Cloud",
      "widget": "stepper",
      "order": 3,
      "hint": "FBM octaves — more = finer detail, heavier"
    },
    {
      "name": "u_softness",
      "label": "Softness",
      "type": "float",
      "default": 1.5,
      "min": 0.3,
      "max": 3.0,
      "step": 0.05,
      "group": "Cloud",
      "widget": "slider",
      "order": 4,
      "hint": "How softly the cloud sphere fades at its edges"
    },
    {
      "name": "u_sphereRadius",
      "label": "Radius",
      "type": "float",
      "default": 2.5,
      "min": 1.0,
      "max": 5.0,
      "step": 0.1,
      "group": "Cloud",
      "widget": "slider",
      "order": 5,
      "hint": "Bounding sphere size"
    },
    {
      "name": "u_threshold",
      "label": "Threshold",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 0.4,
      "step": 0.01,
      "group": "Cloud",
      "widget": "slider",
      "order": 6,
      "hint": "Minimum density before rendering — raise to erode thin clouds"
    },
    {
      "name": "u_absorption",
      "label": "Absorption",
      "type": "float",
      "default": 3.0,
      "min": 0.5,
      "max": 8.0,
      "step": 0.1,
      "group": "Lighting",
      "widget": "slider",
      "order": 10,
      "hint": "How quickly light is absorbed passing through the cloud"
    },
    {
      "name": "u_shadowDist",
      "label": "Shadow dist",
      "type": "float",
      "default": 0.15,
      "min": 0.02,
      "max": 0.6,
      "step": 0.01,
      "group": "Lighting",
      "widget": "slider",
      "order": 11,
      "hint": "How far ahead to sample for self-shadowing"
    },
    {
      "name": "u_shadowAbsorb",
      "label": "Shadow",
      "type": "float",
      "default": 5.0,
      "min": 1.0,
      "max": 12.0,
      "step": 0.25,
      "group": "Lighting",
      "widget": "slider",
      "order": 12,
      "hint": "Shadow darkness — higher = deeper shadows"
    },
    {
      "name": "u_secondaryScatter",
      "label": "Secondary",
      "type": "float",
      "default": 0.4,
      "min": 0.0,
      "max": 1.0,
      "step": 0.02,
      "group": "Lighting",
      "widget": "slider",
      "order": 13,
      "hint": "Ambient fill from light bouncing inside the cloud"
    },
    {
      "name": "u_forwardScatter",
      "label": "Forward scatter",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 0.95,
      "step": 0.01,
      "group": "Lighting",
      "widget": "slider",
      "order": 14,
      "hint": "Henyey-Greenstein asymmetry — higher = tighter forward glow"
    },
    {
      "name": "u_sunIntensity",
      "label": "Sun",
      "type": "float",
      "default": 3.5,
      "min": 0.5,
      "max": 10.0,
      "step": 0.1,
      "group": "Lighting",
      "widget": "slider",
      "order": 15,
      "hint": "Direct sunlight brightness"
    },
    {
      "name": "u_ambientIntensity",
      "label": "Ambient",
      "type": "float",
      "default": 0.01,
      "min": 0.0,
      "max": 0.15,
      "step": 0.005,
      "group": "Lighting",
      "widget": "slider",
      "order": 16,
      "hint": "Sky-fill ambient light"
    },
    {
      "name": "u_powder",
      "label": "Powder",
      "type": "float",
      "default": 12.0,
      "min": 2.0,
      "max": 25.0,
      "step": 0.5,
      "group": "Lighting",
      "widget": "slider",
      "order": 17,
      "hint": "Dark-edge powder effect — higher = more contrast on dense edges"
    },
    {
      "name": "u_speed",
      "label": "Speed",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 3.0,
      "step": 0.05,
      "group": "Motion",
      "widget": "slider",
      "order": 20,
      "hint": "Cloud drift speed (0 freezes)"
    },
    {
      "name": "u_windX",
      "label": "Wind X",
      "type": "float",
      "default": 1.0,
      "min": -2.0,
      "max": 2.0,
      "step": 0.05,
      "group": "Motion",
      "widget": "slider",
      "order": 21,
      "hint": "Horizontal wind direction"
    },
    {
      "name": "u_windZ",
      "label": "Wind Z",
      "type": "float",
      "default": 0.3,
      "min": -2.0,
      "max": 2.0,
      "step": 0.05,
      "group": "Motion",
      "widget": "slider",
      "order": 22,
      "hint": "Depth wind direction"
    },
    {
      "name": "u_camDist",
      "label": "Distance",
      "type": "float",
      "default": 3.5,
      "min": 1.5,
      "max": 8.0,
      "step": 0.1,
      "group": "Camera",
      "widget": "slider",
      "order": 30,
      "hint": "Camera distance from origin"
    },
    {
      "name": "u_camHeight",
      "label": "Height",
      "type": "float",
      "default": 0.0,
      "min": -3.0,
      "max": 4.0,
      "step": 0.1,
      "group": "Camera",
      "widget": "slider",
      "order": 31,
      "hint": "Camera vertical offset"
    },
    {
      "name": "u_fov",
      "label": "FOV",
      "type": "float",
      "default": 1.0,
      "min": 0.3,
      "max": 2.5,
      "step": 0.05,
      "group": "Camera",
      "widget": "slider",
      "order": 32,
      "hint": "Field of view multiplier"
    },
    {
      "name": "u_stepSize",
      "label": "Step size",
      "type": "float",
      "default": 0.08,
      "min": 0.02,
      "max": 0.25,
      "step": 0.005,
      "group": "Ray March",
      "widget": "slider",
      "order": 40,
      "hint": "Ray march step length — smaller = more accurate, heavier"
    },
    {
      "name": "u_sunColor",
      "label": "Sun color",
      "type": "color",
      "default": [1.0, 0.95, 0.85],
      "group": "Sky",
      "widget": "color",
      "order": 50,
      "hint": "Direct light tint"
    },
    {
      "name": "u_skyTop",
      "label": "Zenith",
      "type": "color",
      "default": [0.2, 0.4, 0.8],
      "group": "Sky",
      "widget": "color",
      "order": 51,
      "hint": "Sky color at the top"
    },
    {
      "name": "u_skyBottom",
      "label": "Horizon",
      "type": "color",
      "default": [0.529, 0.8, 0.92],
      "group": "Sky",
      "widget": "color",
      "order": 52,
      "hint": "Sky color at the horizon"
    },
    {
      "name": "u_audioDensity",
      "label": "Beat → Density",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Audio",
      "widget": "slider",
      "format": "percent",
      "order": 60,
      "hint": "How much the beat pulse thickens the clouds"
    },
    {
      "name": "u_audioGlow",
      "label": "Beat → Glow",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Audio",
      "widget": "slider",
      "format": "percent",
      "order": 61,
      "hint": "How much the beat brightens cloud edges"
    },
    {
      "name": "u_audioWind",
      "label": "Bass → Wind",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Audio",
      "widget": "slider",
      "format": "percent",
      "order": 62,
      "hint": "Bass energy pushes the clouds faster"
    },
    {
      "name": "u_beat",
      "label": "Beat",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Audio",
      "widget": "slider",
      "format": "percent",
      "advanced": true,
      "hint": "Overridden by analysis routing"
    },
    {
      "name": "u_envelope",
      "label": "Envelope",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Audio",
      "widget": "slider",
      "format": "percent",
      "advanced": true
    },
    {
      "name": "u_bass",
      "label": "Bass",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Audio",
      "widget": "slider",
      "format": "percent",
      "advanced": true
    },
    {
      "name": "u_intensity",
      "label": "Mix",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Mix",
      "widget": "slider",
      "format": "percent",
      "order": 99,
      "hint": "Blend of clouds vs transparent"
    }
  ]
}
