{
  "id": "interlace",
  "name": "Interlace",
  "description": "Field lines with optional offset weave and flicker. Broadcast / CRT utility without full CRT pack.",
  "roles": ["postprocess"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_amount",
      "label": "Amount",
      "type": "float",
      "default": 0.7,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Utility",
      "widget": "slider",
      "format": "percent"
    },
    {
      "name": "u_offset",
      "label": "Field offset",
      "type": "float",
      "default": 0.35,
      "min": 0.0,
      "max": 1.5,
      "step": 0.01,
      "group": "Utility",
      "widget": "slider"
    },
    {
      "name": "u_darken",
      "label": "Line darken",
      "type": "float",
      "default": 0.35,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Utility",
      "widget": "slider"
    },
    {
      "name": "u_animate",
      "label": "Flicker fields",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 1.0,
      "group": "Utility",
      "widget": "toggle",
      "advanced": true
    },
    {
      "name": "u_intensity",
      "label": "Mix",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Mix",
      "widget": "slider",
      "format": "percent",
      "hint": "0 = original, 1 = full interlace"
    }
  ]
}
