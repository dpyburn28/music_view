{
  "id": "pixelate",
  "name": "Pixelate",
  "description": "Mosaic / low-res block sampling. Useful for lo-fi looks and transitions.",
  "roles": ["postprocess"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_size",
      "label": "Block size",
      "type": "float",
      "default": 8.0,
      "min": 1.0,
      "max": 64.0,
      "step": 1.0,
      "group": "Distort",
      "widget": "stepper",
      "hint": "Pixel block size in screen pixels"
    },
    {
      "name": "u_intensity",
      "label": "Mix",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Mix",
      "widget": "slider",
      "format": "percent",
      "hint": "0 = original scene, 1 = full pixelate"
    }
  ]
}
