{
  "id": "pixel-sort",
  "name": "Pixel Sort",
  "description": "Thresholded luma run sort (approximate). Classic glitch aesthetic; stack with slice/channel tools.",
  "roles": ["postprocess"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_amount",
      "label": "Amount",
      "type": "float",
      "default": 0.65,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Glitch",
      "widget": "slider",
      "format": "percent"
    },
    {
      "name": "u_threshold",
      "label": "Threshold",
      "type": "float",
      "default": 0.35,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Glitch",
      "widget": "slider",
      "hint": "Luma above this starts a sort run"
    },
    {
      "name": "u_length",
      "label": "Length",
      "type": "float",
      "default": 12.0,
      "min": 2.0,
      "max": 24.0,
      "step": 1.0,
      "group": "Glitch",
      "widget": "stepper",
      "hint": "Max run samples"
    },
    {
      "name": "u_axis",
      "label": "Axis",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 1.0,
      "group": "Glitch",
      "widget": "segmented",
      "options": [
        { "value": 0, "label": "H" },
        { "value": 1, "label": "V" }
      ]
    },
    {
      "name": "u_invert",
      "label": "Sort shadows",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 1.0,
      "group": "Glitch",
      "widget": "toggle",
      "advanced": true,
      "hint": "On = sort dark regions instead of bright"
    },
    {
      "name": "u_intensity",
      "label": "Mix",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Mix",
      "widget": "slider",
      "format": "percent",
      "hint": "0 = original, 1 = full sort"
    }
  ]
}
