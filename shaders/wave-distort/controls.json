{
  "id": "wave-distort",
  "name": "Wave Distort",
  "description": "Sine / multi-harmonic UV waves along an axis. Cleaner utility cousin of warp-ripple.",
  "roles": ["postprocess"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_amount",
      "label": "Amount",
      "type": "float",
      "default": 0.4,
      "min": 0.0,
      "max": 2.0,
      "step": 0.01,
      "group": "Distort",
      "widget": "slider"
    },
    {
      "name": "u_frequency",
      "label": "Frequency",
      "type": "float",
      "default": 8.0,
      "min": 0.5,
      "max": 40.0,
      "step": 0.5,
      "group": "Distort",
      "widget": "slider"
    },
    {
      "name": "u_speed",
      "label": "Speed",
      "type": "float",
      "default": 2.0,
      "min": -8.0,
      "max": 8.0,
      "step": 0.1,
      "group": "Distort",
      "widget": "slider"
    },
    {
      "name": "u_angle",
      "label": "Angle",
      "type": "float",
      "default": 0.0,
      "min": -3.1416,
      "max": 3.1416,
      "step": 0.01,
      "group": "Distort",
      "widget": "slider",
      "hint": "Wave propagation direction"
    },
    {
      "name": "u_secondary",
      "label": "Harmonic",
      "type": "float",
      "default": 0.35,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Distort",
      "widget": "slider",
      "advanced": true
    },
    {
      "name": "u_intensity",
      "label": "Mix",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Mix",
      "widget": "slider",
      "format": "percent",
      "hint": "0 = original, 1 = full wave"
    }
  ]
}
