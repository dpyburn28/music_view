{
  "id": "warp-ripple",
  "name": "Warp Ripple",
  "description": "Radial UV waves from center. Strong with music when amplitude is modulated; gentle defaults for liquid stages.",
  "roles": ["postprocess"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_amplitude",
      "label": "Amplitude",
      "type": "float",
      "default": 0.012,
      "min": 0.0,
      "max": 0.08,
      "step": 0.001,
      "group": "Distort",
      "widget": "slider",
      "hint": "Ripple strength (modulator-friendly)"
    },
    {
      "name": "u_frequency",
      "label": "Frequency",
      "type": "float",
      "default": 18.0,
      "min": 1.0,
      "max": 48.0,
      "step": 0.5,
      "group": "Distort",
      "widget": "slider",
      "hint": "Number of rings across the frame"
    },
    {
      "name": "u_speed",
      "label": "Speed",
      "type": "float",
      "default": 2.5,
      "min": 0.0,
      "max": 12.0,
      "step": 0.1,
      "group": "Distort",
      "widget": "slider",
      "hint": "How fast ripples travel"
    },
    {
      "name": "u_intensity",
      "label": "Mix",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Mix",
      "widget": "slider",
      "format": "percent",
      "hint": "0 = original scene, 1 = full warp"
    }
  ]
}
