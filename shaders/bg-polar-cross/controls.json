{
  "id": "bg-polar-cross",
  "name": "Polar Cross",
  "description": "Four-fold polar-warped ripples that pinch into crosses and split into ink blobs. Stage / panel fill.",
  "roles": ["container"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_freq_a",
      "label": "Freq A",
      "type": "float",
      "default": 6.5,
      "min": 1.5,
      "max": 16.0,
      "step": 0.1,
      "group": "Look",
      "widget": "slider",
      "order": 1,
      "hint": "Primary concentric-ripple frequency"
    },
    {
      "name": "u_freq_b",
      "label": "Freq B",
      "type": "float",
      "default": 11.0,
      "min": 2.0,
      "max": 22.0,
      "step": 0.1,
      "group": "Look",
      "widget": "slider",
      "order": 2,
      "hint": "Second interference frequency"
    },
    {
      "name": "u_lobe",
      "label": "Lobe",
      "type": "float",
      "default": 0.48,
      "min": 0.0,
      "max": 1.2,
      "step": 0.01,
      "group": "Look",
      "widget": "slider",
      "order": 3,
      "hint": "Amplitude of sin(theta × fold) — stretches rings into crosses"
    },
    {
      "name": "u_fold",
      "label": "Fold",
      "type": "float",
      "default": 4.0,
      "min": 2.0,
      "max": 8.0,
      "step": 1.0,
      "group": "Look",
      "widget": "stepper",
      "order": 4,
      "hint": "Angular frequency (4 = four-pointed)"
    },
    {
      "name": "u_threshold",
      "label": "Threshold",
      "type": "float",
      "default": 0.62,
      "min": 0.35,
      "max": 0.85,
      "step": 0.01,
      "group": "Look",
      "widget": "slider",
      "order": 5,
      "hint": "Implicit-surface cutoff. Higher = smaller, more isolated blobs"
    },
    {
      "name": "u_edge",
      "label": "Edge",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 0.04,
      "step": 0.001,
      "group": "Look",
      "widget": "slider",
      "order": 6,
      "hint": "0 = hard 1-bit step. Raise for a thin gray halo",
      "advanced": true
    },
    {
      "name": "u_invert",
      "label": "Invert",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 1.0,
      "group": "Look",
      "widget": "toggle",
      "order": 7,
      "advanced": true
    },
    {
      "name": "u_speed",
      "label": "Speed",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 4.0,
      "step": 0.05,
      "group": "Motion",
      "widget": "slider",
      "order": 10,
      "hint": "0 freezes the still"
    }
  ]
}
