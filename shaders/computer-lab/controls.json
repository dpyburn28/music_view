{
  "id": "computer-lab",
  "name": "Computer Lab",
  "description": "Grid of retro lab equipment tiles with CRT screens, keypads, vents, knobs, and blinking LEDs.",
  "roles": ["container"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_speed",
      "label": "Speed",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 4.0,
      "step": 0.05,
      "group": "Animation",
      "widget": "slider",
      "order": 1,
      "hint": "Animation speed"
    },
    {
      "name": "u_tiles",
      "label": "Tile count",
      "type": "float",
      "default": 6.0,
      "min": 3.0,
      "max": 12.0,
      "step": 0.5,
      "group": "Layout",
      "widget": "slider",
      "order": 10,
      "hint": "Number of tiles across"
    },
    {
      "name": "u_screen_glow",
      "label": "Screen glow",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "group": "Style",
      "widget": "slider",
      "order": 20,
      "hint": "CRT screen brightness"
    },
    {
      "name": "u_dirt",
      "label": "Grime",
      "type": "float",
      "default": 0.18,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Style",
      "widget": "slider",
      "format": "percent",
      "order": 21,
      "hint": "Age and dirt amount"
    },
    {
      "name": "u_warmth",
      "label": "Warmth",
      "type": "float",
      "default": 0.18,
      "min": 0.0,
      "max": 0.4,
      "step": 0.01,
      "group": "Style",
      "widget": "slider",
      "format": "percent",
      "order": 22,
      "hint": "Old beige tint"
    },
    {
      "name": "u_saturation",
      "label": "Saturation",
      "type": "float",
      "default": 1.0,
      "min": 0.6,
      "max": 1.4,
      "step": 0.01,
      "group": "Style",
      "widget": "slider",
      "format": "percent",
      "order": 23
    },
    {
      "name": "u_contrast",
      "label": "Contrast",
      "type": "float",
      "default": 1.0,
      "min": 0.7,
      "max": 1.3,
      "step": 0.01,
      "group": "Style",
      "widget": "slider",
      "format": "percent",
      "order": 24
    },
    {
      "name": "u_blink_speed",
      "label": "LED speed",
      "type": "float",
      "default": 2.0,
      "min": 0.0,
      "max": 6.0,
      "step": 0.1,
      "group": "Animation",
      "widget": "slider",
      "order": 2,
      "hint": "LED blink rate"
    }
