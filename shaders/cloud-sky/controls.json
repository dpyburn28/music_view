{
  "id": "cloud-sky",
  "name": "Cloud Sky",
  "description": "2D procedural cloud layer with ridged FBM noise over a gradient sky.",
  "roles": ["container"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_speed",
      "label": "Speed",
      "type": "float",
      "default": 0.03,
      "min": 0.0,
      "max": 0.15,
      "step": 0.005,
      "group": "Motion",
      "widget": "slider",
      "order": 1,
      "hint": "Cloud drift speed"
    },
    {
      "name": "u_cloudscale",
      "label": "Scale",
      "type": "float",
      "default": 1.1,
      "min": 0.3,
      "max": 3.0,
      "step": 0.05,
      "group": "Cloud",
      "widget": "slider",
      "order": 10,
      "hint": "Cloud size"
    },
    {
      "name": "u_cloudcover",
      "label": "Cover",
      "type": "float",
      "default": 0.2,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Cloud",
      "widget": "slider",
      "format": "percent",
      "order": 11,
      "hint": "Minimum cloud opacity"
    },
    {
      "name": "u_cloudalpha",
      "label": "Density",
      "type": "float",
      "default": 8.0,
      "min": 1.0,
      "max": 20.0,
      "step": 0.5,
      "group": "Cloud",
      "widget": "slider",
      "order": 12,
      "hint": "Cloud opacity multiplier"
    },
    {
      "name": "u_clouddark",
      "label": "Dark",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Cloud",
      "widget": "slider",
      "format": "percent",
      "order": 13,
      "hint": "Cloud shadow amount"
    },
    {
      "name": "u_cloudlight",
      "label": "Light",
      "type": "float",
      "default": 0.3,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Cloud",
      "widget": "slider",
      "format": "percent",
      "order": 14,
      "hint": "Cloud highlight amount"
    },
    {
      "name": "u_skytint",
      "label": "Tint",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Sky",
      "widget": "slider",
      "format": "percent",
      "order": 20,
      "hint": "How much clouds tint the sky"
    },
    {
      "name": "u_skycolour1",
      "label": "Horizon",
      "type": "color",
      "default": [0.2, 0.4, 0.6],
      "group": "Sky",
      "widget": "color",
      "order": 21,
      "hint": "Sky color at the horizon"
    },
    {
      "name": "u_skycolour2",
      "label": "Zenith",
      "type": "color",
      "default": [0.4, 0.7, 1.0],
      "group": "Sky",
      "widget": "color",
      "order": 22,
      "hint": "Sky color at the top"
    },
    {
      "name": "u_intensity",
      "label": "Intensity",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Style",
      "widget": "slider",
      "format": "percent",
      "order": 30
    }
  ]
}
