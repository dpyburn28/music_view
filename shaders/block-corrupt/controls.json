{
  "id": "block-corrupt",
  "name": "Block Corrupt",
  "description": "Macroblock-style corruption: random tiles shift or flash. Digital failure aesthetic.",
  "roles": ["postprocess"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_block",
      "label": "Block size",
      "type": "float",
      "default": 24.0,
      "min": 4.0,
      "max": 64.0,
      "step": 1.0,
      "group": "Distort",
      "widget": "stepper",
      "hint": "Tile size in pixels"
    },
    {
      "name": "u_density",
      "label": "Density",
      "type": "float",
      "default": 0.2,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Distort",
      "widget": "slider",
      "format": "percent",
      "hint": "Fraction of tiles that glitch"
    },
    {
      "name": "u_amount",
      "label": "Amount",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Distort",
      "widget": "slider",
      "format": "percent",
      "hint": "Shift / chaos strength"
    },
    {
      "name": "u_speed",
      "label": "Speed",
      "type": "float",
      "default": 4.0,
      "min": 0.0,
      "max": 20.0,
      "step": 0.5,
      "group": "Distort",
      "widget": "slider"
    },
    {
      "name": "u_intensity",
      "label": "Mix",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Mix",
      "widget": "slider",
      "format": "percent",
      "hint": "0 = original scene, 1 = full corrupt"
    }
  ]
}
