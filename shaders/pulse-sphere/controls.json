{
  "id": "pulse-sphere",
  "name": "Pulse Sphere",
  "description": "Pulsing radial sphere with concentric wave rings and oscillating brightness.",
  "roles": ["container"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_speed",
      "label": "Speed",
      "type": "float",
      "default": 3.0,
      "min": 0.0,
      "max": 10.0,
      "step": 0.1,
      "group": "Motion",
      "widget": "slider",
      "order": 1,
      "hint": "Overall animation speed"
    },
    {
      "name": "u_wave_freq",
      "label": "Wave frequency",
      "type": "float",
      "default": 100.0,
      "min": 10.0,
      "max": 300.0,
      "step": 5.0,
      "group": "Shape",
      "widget": "slider",
      "order": 10,
      "hint": "Number of concentric rings"
    },
    {
      "name": "u_wave_depth",
      "label": "Wave depth",
      "type": "float",
      "default": 0.6,
      "min": 0.0,
      "max": 1.0,
      "step": 0.02,
      "group": "Shape",
      "widget": "slider",
      "format": "percent",
      "order": 11,
      "hint": "How strongly rings modulate brightness"
    },
    {
      "name": "u_radius",
      "label": "Radius",
      "type": "float",
      "default": 0.5,
      "min": 0.1,
      "max": 1.5,
      "step": 0.02,
      "group": "Shape",
      "widget": "slider",
      "order": 12,
      "hint": "Visible sphere boundary"
    },
    {
      "name": "u_falloff",
      "label": "Falloff",
      "type": "float",
      "default": 3.0,
      "min": 1.0,
      "max": 5.0,
      "step": 0.1,
      "group": "Shape",
      "widget": "slider",
      "order": 13,
      "hint": "Exponent of distance falloff — higher = sharper edge"
    },
    {
      "name": "u_breathe",
      "label": "Breathe",
      "type": "float",
      "default": 5.0,
      "min": 0.0,
      "max": 15.0,
      "step": 0.25,
      "group": "Motion",
      "widget": "slider",
      "order": 2,
      "hint": "How much the height oscillation varies over time"
    },
    {
      "name": "u_breathe_rate",
      "label": "Breathe rate",
      "type": "float",
      "default": 0.33,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "group": "Motion",
      "widget": "slider",
      "order": 3,
      "hint": "Speed of the breathing oscillation"
    },
    {
      "name": "u_edge_fade",
      "label": "Edge fade",
      "type": "float",
      "default": 0.652,
      "min": 0.0,
      "max": 1.5,
      "step": 0.01,
      "group": "Style",
      "widget": "slider",
      "order": 20,
      "hint": "How much brightness drops at the boundary"
    },
    {
      "name": "u_bright",
      "label": "Brightness",
      "type": "float",
      "default": 0.9,
      "min": 0.0,
      "max": 1.5,
      "step": 0.01,
      "group": "Style",
      "widget": "slider",
      "order": 21,
      "hint": "Peak sphere brightness"
    },
    {
      "name": "u_core_dark",
      "label": "Core dark",
      "type": "float",
      "default": 0.1,
      "min": 0.0,
      "max": 0.5,
      "step": 0.01,
      "group": "Style",
      "widget": "slider",
      "format": "percent",
      "order": 22,
      "hint": "Background darkness inside the sphere"
    },
    {
      "name": "u_color_r",
      "label": "R",
      "type": "float",
      "default": 0.9,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Color",
      "widget": "slider",
      "format": "percent",
      "order": 30
    },
    {
      "name": "u_color_g",
      "label": "G",
      "type": "float",
      "default": 0.9,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Color",
      "widget": "slider",
      "format": "percent",
      "order": 31
    },
    {
      "name": "u_color_b",
      "label": "B",
      "type": "float",
      "default": 0.9,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Color",
      "widget": "slider",
      "format": "percent",
      "order": 32
    }
  ]
}
