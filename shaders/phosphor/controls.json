{
  "id": "phosphor",
  "name": "Phosphor Persistence",
  "description": "Temporal CRT/oscilloscope trails: blends each frame with the previous output so bright motion leaves a fading glow. Uses frame feedback.",
  "roles": [
    "postprocess"
  ],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_decay",
      "label": "Decay",
      "type": "float",
      "default": 0.88,
      "min": 0.5,
      "max": 0.98,
      "step": 0.005,
      "group": "Trail",
      "widget": "slider",
      "hint": "Lower = longer trails"
    },
    {
      "name": "u_gain",
      "label": "Frame gain",
      "type": "float",
      "default": 1.0,
      "min": 0.3,
      "max": 2.0,
      "step": 0.01,
      "group": "Trail",
      "widget": "slider"
    },
    {
      "name": "u_threshold",
      "label": "Threshold",
      "type": "float",
      "default": 0.08,
      "min": 0.0,
      "max": 0.5,
      "step": 0.01,
      "group": "Trail",
      "advanced": true,
      "widget": "slider"
    },
    {
      "name": "u_bloom",
      "label": "Bloom",
      "type": "float",
      "default": 0.2,
      "min": 0.0,
      "max": 0.8,
      "step": 0.01,
      "group": "Trail",
      "advanced": true,
      "widget": "slider"
    },
    {
      "name": "u_tint",
      "label": "Phosphor tint",
      "type": "color",
      "default": [
        0.75,
        1.0,
        0.7
      ],
      "group": "Color",
      "advanced": true,
      "widget": "color"
    },
    {
      "name": "u_intensity",
      "label": "Effect mix",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Mix",
      "format": "percent",
      "unit": "%",
      "hint": "Blend of processed vs original",
      "widget": "slider"
    }
  ]
}
