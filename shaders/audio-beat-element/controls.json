{
  "id": "audio-beat-element",
  "name": "Elemental Sim",
  "description": "Continuous baseline flow with audio-reactive ripple visibility.",
  "roles": ["container"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_mode",
      "label": "Simulation State",
      "type": "float",
      "default": 1.0,
      "group": "Physics",
      "widget": "segmented",
      "options": [
        { "value": 0, "label": "Sand" },
        { "value": 1, "label": "Water" },
        { "value": 2, "label": "Smoke" },
        { "value": 3, "label": "Fire" }
      ],
      "order": 1
    },
    {
      "name": "u_density",
      "label": "Density",
      "type": "float",
      "default": 18.0,
      "min": 6.0,
      "max": 35.0,
      "step": 1.0,
      "group": "Physics",
      "widget": "slider",
      "order": 2
    },
    {
      "name": "u_flow_spread",
      "label": "Ripple Spread",
      "type": "float",
      "default": 0.7,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "group": "Physics",
      "widget": "slider",
      "order": 3,
      "hint": "How far the audio ripple expands outward"
    },
    {
      "name": "u_turbulence",
      "label": "Turbulence",
      "type": "float",
      "default": 0.2,
      "min": 0.0,
      "max": 1.0,
      "step": 0.02,
      "group": "Physics",
      "widget": "slider",
      "order": 4
    },
    {
      "name": "u_audio_gain",
      "label": "Sensitivity / Gain",
      "type": "float",
      "default": 1.5,
      "min": 0.1,
      "max": 4.0,
      "step": 0.05,
      "group": "Audio",
      "widget": "slider",
      "order": 10
    },
    {
      "name": "u_bass_response",
      "label": "Bass Weight",
      "type": "float",
      "default": 1.2,
      "min": 0.0,
      "max": 3.0,
      "step": 0.05,
      "group": "Audio",
      "widget": "slider",
      "order": 11
    },
    {
      "name": "u_beat",
      "label": "Beat",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Audio",
      "widget": "slider",
      "format": "percent",
      "advanced": true
    },
    {
      "name": "u_envelope",
      "label": "Envelope",
      "type": "float",
      "default": 0.4,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Audio",
      "widget": "slider",
      "format": "percent",
      "advanced": true
    },
    {
      "name": "u_bass",
      "label": "Bass",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Audio",
      "widget": "slider",
      "format": "percent",
      "advanced": true
    },
    {
      "name": "u_beat_phase",
      "label": "Beat Phase",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 10000.0,
      "step": 1.0,
      "group": "Audio",
      "widget": "number",
      "advanced": true
    },
    {
      "name": "u_color_core",
      "label": "Core Color",
      "type": "color",
      "default": [1.0, 0.9, 0.6],
      "group": "Style",
      "widget": "color",
      "order": 20
    },
    {
      "name": "u_color_mid",
      "label": "Midtone",
      "type": "color",
      "default": [0.2, 0.6, 1.0],
      "group": "Style",
      "widget": "color",
      "order": 21
    },
    {
      "name": "u_color_edge",
      "label": "Edge Dissolve",
      "type": "color",
      "default": [0.02, 0.05, 0.15],
      "group": "Style",
      "widget": "color",
      "order": 22
    },
    {
      "name": "u_bg_color",
      "label": "Background",
      "type": "color",
      "default": [0.01, 0.01, 0.03],
      "group": "Style",
      "widget": "color",
      "order": 23
    },
    {
      "name": "u_intensity",
      "label": "Intensity",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Style",
      "widget": "slider",
      "format": "percent",
      "order": 24
    }
  ]
}