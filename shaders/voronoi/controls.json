{
  "id": "voronoi",
  "name": "Voronoi",
  "description": "Crystal cell mosaic with optional animation. Stained-glass / organic tile looks.",
  "roles": ["postprocess"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_scale",
      "label": "Scale",
      "type": "float",
      "default": 12.0,
      "min": 3.0,
      "max": 40.0,
      "step": 0.5,
      "group": "Style",
      "widget": "slider",
      "hint": "Cell density"
    },
    {
      "name": "u_edge",
      "label": "Edge",
      "type": "float",
      "default": 0.08,
      "min": 0.01,
      "max": 0.4,
      "step": 0.005,
      "group": "Style",
      "widget": "slider",
      "hint": "Border thickness"
    },
    {
      "name": "u_jitter",
      "label": "Jitter",
      "type": "float",
      "default": 0.85,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Style",
      "widget": "slider",
      "hint": "0 = grid, 1 = organic cells"
    },
    {
      "name": "u_animate",
      "label": "Animate",
      "type": "float",
      "default": 0.2,
      "min": 0.0,
      "max": 2.0,
      "step": 0.01,
      "group": "Style",
      "widget": "slider"
    },
    {
      "name": "u_intensity",
      "label": "Mix",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Mix",
      "widget": "slider",
      "format": "percent",
      "hint": "0 = original scene, 1 = full Voronoi"
    }
  ]
}
