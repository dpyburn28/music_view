{
  "id": "barrel",
  "name": "Lens Distortion",
  "description": "Barrel / pincushion UV warp with optional zoom compensate so edges stay filled.",
  "roles": ["postprocess"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_amount",
      "label": "Amount",
      "type": "float",
      "default": 0.15,
      "min": -0.6,
      "max": 0.6,
      "step": 0.005,
      "group": "Optics",
      "widget": "slider",
      "hint": "Positive = barrel, negative = pincushion"
    },
    {
      "name": "u_zoom",
      "label": "Zoom",
      "type": "float",
      "default": 1.05,
      "min": 0.85,
      "max": 1.25,
      "step": 0.005,
      "group": "Optics",
      "widget": "slider",
      "hint": "Scale UV to hide empty corners after warp"
    },
    {
      "name": "u_intensity",
      "label": "Mix",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Mix",
      "widget": "slider",
      "format": "percent",
      "hint": "0 = original scene, 1 = full distortion"
    }
  ]
}
