{
  "id": "bg-barcode-escalate",
  "name": "Barcode Escalate",
  "description": "Intersecting blocks that subdivide into a high-frequency vertical barcode. Stage / panel fill.",
  "roles": ["container"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_freq_x",
      "label": "X frequency",
      "type": "float",
      "default": 3.0,
      "min": 0.5,
      "max": 16.0,
      "step": 0.1,
      "group": "Look",
      "widget": "slider",
      "order": 1,
      "hint": "Starting vertical-band count before escalation"
    },
    {
      "name": "u_freq_y",
      "label": "Y frequency",
      "type": "float",
      "default": 2.0,
      "min": 0.25,
      "max": 10.0,
      "step": 0.05,
      "group": "Look",
      "widget": "slider",
      "order": 2,
      "hint": "Starting horizontal-band count (visible at t ≈ 0)"
    },
    {
      "name": "u_shape",
      "label": "Peak shape",
      "type": "float",
      "default": 6.0,
      "min": 1.0,
      "max": 18.0,
      "step": 0.1,
      "group": "Look",
      "widget": "slider",
      "order": 3,
      "hint": "pow() exponent — higher crushes midtones into thin white peaks"
    },
    {
      "name": "u_edge",
      "label": "Edge",
      "type": "float",
      "default": 0.55,
      "min": 0.05,
      "max": 0.95,
      "step": 0.01,
      "group": "Look",
      "widget": "slider",
      "format": "percent",
      "order": 4,
      "hint": "smoothstep threshold for black vs glowing white"
    },
    {
      "name": "u_intersect",
      "label": "Intersect",
      "type": "float",
      "default": 0.35,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Look",
      "widget": "slider",
      "format": "percent",
      "order": 5,
      "hint": "0 = add bands, 1 = multiply (crosses only)",
      "advanced": true
    },
    {
      "name": "u_escalate",
      "label": "Escalate",
      "type": "float",
      "default": 0.55,
      "min": 0.05,
      "max": 1.5,
      "step": 0.01,
      "group": "Motion",
      "widget": "slider",
      "order": 10,
      "hint": "speed_factor inside exp(t * escalate) for X frequency"
    },
    {
      "name": "u_y_decay",
      "label": "Y decay",
      "type": "float",
      "default": 0.45,
      "min": 0.0,
      "max": 2.0,
      "step": 0.01,
      "group": "Motion",
      "widget": "slider",
      "order": 11,
      "hint": "How fast horizontal bands fade as the barcode takes over"
    },
    {
      "name": "u_period",
      "label": "Period",
      "type": "float",
      "default": 10.0,
      "min": 0.0,
      "max": 30.0,
      "step": 0.25,
      "group": "Motion",
      "widget": "slider",
      "unit": "s",
      "order": 12,
      "hint": "Loop length in seconds. 0 = escalate once and hold"
    },
    {
      "name": "u_speed",
      "label": "Speed",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 4.0,
      "step": 0.05,
      "group": "Motion",
      "widget": "slider",
      "order": 13,
      "hint": "0 freezes at t = 0 (large intersecting blocks)"
    }
  ]
}
