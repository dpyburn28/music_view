{
  "id": "bg-number-cascade",
  "name": "Number Cascade",
  "description": "Integers on diagonal tracks that fade in from white and slide top-left to bottom-right. Stage / panel fill.",
  "roles": ["container"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_tracks",
      "label": "Tracks",
      "type": "float",
      "default": 14.0,
      "min": 4.0,
      "max": 28.0,
      "step": 1.0,
      "group": "Look",
      "widget": "slider",
      "order": 1,
      "hint": "How many parallel diagonal lines"
    },
    {
      "name": "u_spacing",
      "label": "Spacing",
      "type": "float",
      "default": 16.0,
      "min": 6.0,
      "max": 28.0,
      "step": 0.5,
      "group": "Look",
      "widget": "slider",
      "order": 2,
      "hint": "Instances along each track"
    },
    {
      "name": "u_density",
      "label": "Density",
      "type": "float",
      "default": 0.55,
      "min": 0.15,
      "max": 1.0,
      "step": 0.01,
      "group": "Look",
      "widget": "slider",
      "format": "percent",
      "order": 3
    },
    {
      "name": "u_contrast",
      "label": "Contrast",
      "type": "float",
      "default": 0.65,
      "min": 0.15,
      "max": 1.0,
      "step": 0.01,
      "group": "Look",
      "widget": "slider",
      "format": "percent",
      "order": 4,
      "hint": "How many numbers sit near-black vs pale gray"
    },
    {
      "name": "u_cascade",
      "label": "Cascade",
      "type": "float",
      "default": 0.22,
      "min": 0.0,
      "max": 1.5,
      "step": 0.01,
      "group": "Motion",
      "widget": "slider",
      "order": 10,
      "hint": "Slide speed along the diagonal"
    },
    {
      "name": "u_fade",
      "label": "Fade in",
      "type": "float",
      "default": 0.28,
      "min": 0.0,
      "max": 1.5,
      "step": 0.01,
      "group": "Motion",
      "widget": "slider",
      "order": 11,
      "hint": "How fast instances appear from white. 0 = all visible"
    },
    {
      "name": "u_speed",
      "label": "Speed",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 4.0,
      "step": 0.05,
      "group": "Motion",
      "widget": "slider",
      "order": 12,
      "hint": "0 freezes. Low + Fade in = the opening reveal"
    }
  ]
}
