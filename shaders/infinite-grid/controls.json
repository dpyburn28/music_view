{
  "id": "infinite-grid",
  "name": "Infinite Grid",
  "description": "Recursive grid texture that folds into itself with perspective depth and fog.",
  "roles": ["container"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_speed",
      "label": "Speed",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 3.0,
      "step": 0.05,
      "group": "Motion",
      "widget": "slider",
      "order": 1,
      "hint": "Scroll speed"
    },
    {
      "name": "u_scroll_x",
      "label": "Scroll X",
      "type": "float",
      "default": 0.0,
      "min": -5.0,
      "max": 5.0,
      "step": 0.1,
      "group": "Motion",
      "widget": "slider",
      "order": 2,
      "hint": "Horizontal scroll offset"
    },
    {
      "name": "u_rotation",
      "label": "Rotation",
      "type": "float",
      "default": 0.0,
      "min": -3.14,
      "max": 3.14,
      "step": 0.02,
      "group": "Motion",
      "widget": "slider",
      "order": 3,
      "hint": "View rotation angle"
    },
    {
      "name": "u_zoom",
      "label": "Zoom",
      "type": "float",
      "default": 1.0,
      "min": 0.3,
      "max": 3.0,
      "step": 0.05,
      "group": "Shape",
      "widget": "slider",
      "order": 10,
      "hint": "Field of view"
    },
    {
      "name": "u_scale",
      "label": "Fold scale",
      "type": "float",
      "default": 1.3,
      "min": 0.8,
      "max": 2.0,
      "step": 0.02,
      "group": "Shape",
      "widget": "slider",
      "order": 11,
      "hint": "How much space shrinks each fold"
    },
    {
      "name": "u_line_w",
      "label": "Line width",
      "type": "float",
      "default": 0.9,
      "min": 0.1,
      "max": 1.0,
      "step": 0.01,
      "group": "Shape",
      "widget": "slider",
      "format": "percent",
      "order": 12,
      "hint": "Grid line thickness"
    },
    {
      "name": "u_fog_decay",
      "label": "Fog fade",
      "type": "float",
      "default": 0.9,
      "min": 0.5,
      "max": 1.0,
      "step": 0.01,
      "group": "Style",
      "widget": "slider",
      "format": "percent",
      "order": 20,
      "hint": "How quickly depth fades to black"
    },
    {
      "name": "u_color_r",
      "label": "R",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Color",
      "widget": "slider",
      "format": "percent",
      "order": 30
    },
    {
      "name": "u_color_g",
      "label": "G",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Color",
      "widget": "slider",
      "format": "percent",
      "order": 31
    },
    {
      "name": "u_color_b",
      "label": "B",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Color",
      "widget": "slider",
      "format": "percent",
      "order": 32
    },
    {
      "name": "u_intensity",
      "label": "Intensity",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Style",
      "widget": "slider",
      "format": "percent",
      "order": 21
    }
  ]
}
