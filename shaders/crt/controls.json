{
  "id": "crt",
  "name": "CRT TV",
  "description": "Cathode-ray tube: barrel curvature, RGB mask, scanlines, phosphor bloom, vignette, and slight jitter.",
  "roles": [
    "postprocess"
  ],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_curvature",
      "label": "Curvature",
      "type": "float",
      "default": 0.12,
      "min": 0.0,
      "max": 0.45,
      "step": 0.005,
      "group": "Screen",
      "widget": "slider"
    },
    {
      "name": "u_scanline",
      "label": "Scanlines",
      "type": "float",
      "default": 0.55,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Screen",
      "widget": "slider"
    },
    {
      "name": "u_mask",
      "label": "RGB mask",
      "type": "float",
      "default": 0.45,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Screen",
      "widget": "slider"
    },
    {
      "name": "u_mask_scale",
      "label": "Mask scale",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 3.0,
      "step": 0.05,
      "group": "Screen",
      "advanced": true,
      "widget": "slider"
    },
    {
      "name": "u_bloom",
      "label": "Bloom",
      "type": "float",
      "default": 0.28,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Color",
      "advanced": true,
      "widget": "slider"
    },
    {
      "name": "u_brightness",
      "label": "Brightness",
      "type": "float",
      "default": 1.15,
      "min": 0.4,
      "max": 2.0,
      "step": 0.01,
      "group": "Color",
      "widget": "slider"
    },
    {
      "name": "u_contrast",
      "label": "Contrast",
      "type": "float",
      "default": 1.08,
      "min": 0.5,
      "max": 2.0,
      "step": 0.01,
      "group": "Color",
      "advanced": true,
      "widget": "slider"
    },
    {
      "name": "u_vignette",
      "label": "Vignette",
      "type": "float",
      "default": 0.4,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Screen",
      "widget": "slider"
    },
    {
      "name": "u_jitter",
      "label": "H. jitter",
      "type": "float",
      "default": 0.002,
      "min": 0.0,
      "max": 0.02,
      "step": 0.0005,
      "group": "Noise",
      "advanced": true,
      "widget": "slider"
    },
    {
      "name": "u_aberration",
      "label": "Aberration",
      "type": "float",
      "default": 0.0015,
      "min": 0.0,
      "max": 0.01,
      "step": 0.0005,
      "group": "Noise",
      "advanced": true,
      "widget": "slider"
    },
    {
      "name": "u_tint",
      "label": "Phosphor tint",
      "type": "color",
      "default": [
        0.95,
        1.0,
        0.92
      ],
      "group": "Color",
      "advanced": true,
      "widget": "color"
    },
    {
      "name": "u_intensity",
      "label": "Effect mix",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Mix",
      "format": "percent",
      "unit": "%",
      "hint": "Blend of processed vs original",
      "widget": "slider"
    }
  ]
}
