{
  "id": "audio-scope",
  "name": "Audio Scope",
  "description": "Oscilloscope-style waveform. Live data from analysis; style and vertical range are fully tunable.",
  "roles": ["container"],
  "entry": "shader.frag",
  "uniforms": [
    {
      "name": "u_color",
      "label": "Trace",
      "type": "color",
      "default": [0.25, 0.95, 0.75],
      "group": "Style",
      "widget": "color",
      "order": 1,
      "hint": "Main phosphor / line color"
    },
    {
      "name": "u_core_color",
      "label": "Core",
      "type": "color",
      "default": [0.9, 1.0, 0.95],
      "group": "Style",
      "widget": "color",
      "order": 2,
      "hint": "Bright center of the trace"
    },
    {
      "name": "u_bg_color",
      "label": "Background",
      "type": "color",
      "default": [0.015, 0.035, 0.05],
      "group": "Style",
      "widget": "color",
      "order": 3
    },
    {
      "name": "u_thickness",
      "label": "Weight",
      "type": "float",
      "default": 0.018,
      "min": 0.003,
      "max": 0.08,
      "step": 0.001,
      "group": "Style",
      "widget": "slider",
      "order": 4,
      "hint": "Trace line thickness"
    },
    {
      "name": "u_glow",
      "label": "Glow",
      "type": "float",
      "default": 0.55,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Style",
      "widget": "slider",
      "format": "percent",
      "order": 5
    },
    {
      "name": "u_fill",
      "label": "Fill",
      "type": "float",
      "default": 0.15,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Style",
      "widget": "slider",
      "format": "percent",
      "order": 6,
      "hint": "Soft fill under the trace"
    },
    {
      "name": "u_intensity",
      "label": "Intensity",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Style",
      "widget": "slider",
      "format": "percent",
      "order": 7
    },
    {
      "name": "u_range",
      "label": "Y range",
      "type": "float",
      "default": 0.42,
      "min": 0.1,
      "max": 0.95,
      "step": 0.01,
      "group": "Trace",
      "widget": "slider",
      "format": "percent",
      "order": 10,
      "hint": "Vertical amplitude span (how tall the wave draws)"
    },
    {
      "name": "u_gain",
      "label": "Gain",
      "type": "float",
      "default": 1.0,
      "min": 0.1,
      "max": 4.0,
      "step": 0.05,
      "group": "Trace",
      "widget": "slider",
      "order": 11,
      "hint": "Amplitude multiplier on samples"
    },
    {
      "name": "u_mirror",
      "label": "Mirror",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 1.0,
      "group": "Trace",
      "widget": "toggle",
      "order": 12,
      "hint": "Draw symmetric reflection of the trace"
    },
    {
      "name": "u_grid",
      "label": "Grid",
      "type": "float",
      "default": 0.35,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Chrome",
      "widget": "slider",
      "format": "percent",
      "order": 20
    },
    {
      "name": "u_baseline",
      "label": "Baseline",
      "type": "float",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Chrome",
      "widget": "slider",
      "format": "percent",
      "order": 21
    },
    {
      "name": "u_grain",
      "label": "Grain",
      "type": "float",
      "default": 0.35,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Chrome",
      "widget": "slider",
      "format": "percent",
      "order": 22
    },
    {
      "name": "u_vignette",
      "label": "Vignette",
      "type": "float",
      "default": 0.4,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Chrome",
      "widget": "slider",
      "format": "percent",
      "order": 23
    },
    {
      "name": "u_signal",
      "label": "Signal",
      "type": "float",
      "default": 0.55,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "group": "Audio",
      "widget": "slider",
      "format": "percent",
      "advanced": true,
      "hint": "Live energy (overridden by analysis)"
    },
    {
      "name": "u_freq",
      "label": "Synth freq",
      "type": "float",
      "default": 2.5,
      "min": 0.25,
      "max": 12.0,
      "step": 0.05,
      "group": "Audio",
      "widget": "slider",
      "advanced": true,
      "hint": "Only used when live wave is off"
    },
    {
      "name": "u_use_wave",
      "label": "Use live wave",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 1.0,
      "group": "Audio",
      "widget": "toggle",
      "advanced": true,
      "hint": "Set automatically when analysis is live"
    }
  ]
}
